# SIF MCP configuration. Keep the real key only in .env.
SIF_MCP_URL=https://mcp.sif.com/mcp
SIF_MCP_SECRET_KEY=

# GPT configuration. The model can be changed without code changes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=1
OPENAI_RETRY_DELAY_SECONDS=2

# Optional official OpenAI fallback. When both keys are present, the app
# tries the middleman above first and switches here after transient failures.
OPENAI_OFFICIAL_BASE_URL=https://api.openai.com/v1
OPENAI_OFFICIAL_API_KEY=
OPENAI_OFFICIAL_MODEL=gpt-5.6-sol

# Set true to use local demo data even when a SIF key is present.
DEMO_MODE=false
HOST=127.0.0.1
PORT=8090
# Maximum number of SIF/GPT analysis jobs processed at the same time.
ANALYSIS_CONCURRENCY=2

# Application authentication. The first startup creates this admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请修改为强密码
SESSION_EXPIRE_DAYS=7
DATABASE_PATH=data/sif.sqlite3

# 亚马逊养号网站集成配置（可选）
# 启用后，分析结果页可直接上传模拟买家评论到养号网站的直评任务表
YMX_API_URL=http://localhost/ymx.com/api/import_reviews_from_sif.php
YMX_API_KEY=sif-import-key-2026
YMX_ENABLED=false
